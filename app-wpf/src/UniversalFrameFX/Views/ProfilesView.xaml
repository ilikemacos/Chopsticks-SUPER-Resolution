<UserControl x:Class="UniversalFrameFX.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Profiles" FontSize="26" FontWeight="SemiBold"
                   Foreground="{StaticResource Text}" Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Saved profiles -->
            <StackPanel Grid.Column="0">
                <ListBox x:Name="ProfileList" Height="380"
                         Style="{StaticResource DarkListBox}" />
                <TextBlock x:Name="StorageNote" FontSize="11.5" Margin="4,10,0,0"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Editor -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" />

                    <TextBlock Text="Executable path" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExeBox" Grid.Column="0" />
                        <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse…"
                                Style="{StaticResource GhostButton}" Width="90" Click="Browse_Click" />
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Graphics API" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ApiBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Upscaler" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="UpscalerBox" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quality mode" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="QualityBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Frame generation" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FrameGenBox" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Output width" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="WidthBox" Width="110" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Output height" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HeightBox" Width="110" HorizontalAlignment="Left" />
                        </StackPanel>
                        <CheckBox x:Name="FrameGenEnabled" Grid.Column="3" Content="Frame generation enabled"
                                  VerticalAlignment="Bottom" Margin="8,0,0,6" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Width="92"
                                Margin="0,0,8,0" Click="Save_Click" />
                        <Button Content="Delete" Style="{StaticResource GhostButton}" Width="92"
                                Margin="0,0,8,0" Click="Delete_Click" />
                        <Button Content="Export" Style="{StaticResource GhostButton}" Width="92"
                                Margin="0,0,8,0" Click="Export_Click" />
                        <Button Content="Import" Style="{StaticResource GhostButton}" Width="92"
                                Click="Import_Click" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,14" />

                    <TextBlock Text="Game folder backup" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="Copies a game's config files (.ini/.cfg/.json/.xml) before you change them. Refuses folders that carry anti-cheat."
                               FontSize="11.5" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Back up folder…" Style="{StaticResource GhostButton}" Width="150"
                                Margin="0,0,8,0" Click="Backup_Click" />
                        <Button Content="Restore latest" Style="{StaticResource GhostButton}" Width="150"
                                Click="Restore_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
