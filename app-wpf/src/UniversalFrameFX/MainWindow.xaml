<Window x:Class="UniversalFrameFX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal FrameFX"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,10">
                    <TextBlock Text="FrameFX" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="Universal upscaling toolkit" FontSize="11.5"
                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText"
                           Margin="24,0,0,16" FontSize="11.5"
                           Foreground="{StaticResource Muted}" />

                <StackPanel x:Name="NavPanel" DockPanel.Dock="Top" Margin="0,10,0,0" />
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Padding="32,28,32,28">
            <ContentControl x:Name="PageHost" />
        </ScrollViewer>
    </Grid>
</Window>
